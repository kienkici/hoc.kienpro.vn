# =============================================================================
# KIENPRO LMS - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# =============================================================================

# 1. APP CONFIGURATION
NEXT_PUBLIC_APP_URL="http://localhost:3002"
NEXT_PUBLIC_APP_NAME="KIENPRO LMS"

# 2. SUPABASE CONFIGURATION
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"
SUPABASE_SECRET_KEY="your-service-role-key-here" # Server-only secret
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# FALLBACK STANDARD FOR COMPATIBILITY
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here" # Server-only secret
